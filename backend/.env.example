# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
ENVIRONMENT=development

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,https://your-netlify-app.netlify.app

# Data Configuration
DATA_DIR=./data
QLIB_DATA_DIR=./qlib_data
MODEL_DIR=./models

# Stock Market Settings
DEFAULT_MARKET=IDX
STOCK_SUFFIX=.JK

# Database (Optional)
DATABASE_URL=sqlite+aiosqlite:///./stock_predictor.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Model Configuration
MODEL_TYPE=lightgbm
TRAINING_PERIOD=1825  # 5 years in days
PREDICTION_HORIZON=5  # days ahead
